[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%ManufacturerName%
CatalogFile=cqkeys.cat
DriverVer=11/13/2026,2.0.0.1000
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%DiskName%,,,""

[SourceDisksFiles]
cqkeys.sys=1

[Manufacturer]
%ManufacturerName%=Standard,NTamd64.10.0...17763

[Standard.NTamd64.10.0...17763]
%DeviceDesc%=cqkeys_Device,Root\cqkeys_vhf

[cqkeys_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
cqkeys.sys

[cqkeys_Device.NT.HW]
AddReg=cqkeys_Hardware

[cqkeys_Hardware]
HKR,,LowerFilters,0x00010000,"vhf"
HKR,,Security,0x00000000,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[cqkeys_Device.NT.Services]
AddService=cqkeysVhf,0x00000002,cqkeys_Service

[cqkeys_Service]
DisplayName=%ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\cqkeys.sys

[cqkeys_Device.NT.Wdf]
KmdfService=cqkeysVhf,cqkeys_Wdf

[cqkeys_Wdf]
KmdfLibraryVersion=1.15

[Strings]
ManufacturerName="CQDLL"
DiskName="CQKeys VHF Driver Package"
DeviceDesc="CQKeys Virtual HID Source"
ServiceDesc="CQKeys KMDF VHF Driver"
