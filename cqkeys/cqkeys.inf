[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%Manufacturer%
CatalogFile=cqkeys.cat
DriverVer=10/20/2026,2.0.0.0
PnpLockdown=1

[DestinationDirs]
DriverCopy=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
cqkeys.sys=1

[Manufacturer]
%Manufacturer%=Models,NTamd64.10.0...16299

[Models.NTamd64.10.0...16299]
%DeviceDescription%=Install,ROOT\CQKEYSVHF

[Install.NT]
CopyFiles=DriverCopy

[DriverCopy]
cqkeys.sys

[Install.NT.HW]
AddReg=DeviceSettings

[DeviceSettings]
HKR,,"LowerFilters",0x00010000,"vhf"
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[Install.NT.Services]
AddService=cqkeys_vhf,0x00000002,Service

[Service]
DisplayName=%DeviceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\cqkeys.sys

[Install.NT.Wdf]
KmdfService=cqkeys_vhf,Wdf

[Wdf]
KmdfLibraryVersion=1.15

[Strings]
Manufacturer="CQDLL"
DiskName="CQKeys VHF Driver"
DeviceDescription="CQKeys Virtual HID Input Device"
