;
; lykeys.inf
;

[Version]
Signature="$WINDOWS NT$"
Class=System ; 改用System类而不是Sample
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318} ; System类的GUID
Provider=%ManufacturerName%
CatalogFile=lykeys.cat
DriverVer=01/01/2024,1.0.0.1
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 12
lykeys_Device_CoInstaller_CopyFiles = 11

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
lykeys.sys  = 1,,
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll=1

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$

[Standard.NT$ARCH$]
%lykeys.DeviceDesc%=lykeys_Device, Root\lykeys

[lykeys_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
lykeys.sys

;-------------- Service installation
[lykeys_Device.NT.Services]
AddService = lykeys,%SPSVCINST_ASSOCSERVICE%, lykeys_Service_Inst

; -------------- lykeys driver install sections
[lykeys_Service_Inst]
DisplayName    = %lykeys.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\lykeys.sys

;
;--- lykeys_Device Coinstaller installation ------
;

[lykeys_Device.NT.CoInstallers]
AddReg=lykeys_Device_CoInstaller_AddReg
CopyFiles=lykeys_Device_CoInstaller_CopyFiles

[lykeys_Device_CoInstaller_AddReg]
HKR,,CoInstallers32,0x00010000, "WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll,WdfCoInstaller"

[lykeys_Device_CoInstaller_CopyFiles]
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll

[lykeys_Device.NT.Wdf]
KmdfService =  lykeys, lykeys_wdfsect
[lykeys_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE= 0x00000002
ManufacturerName="LYDLL" 
DiskName = "LYDLL Installation Disk"
lykeys.DeviceDesc = "LYDLL Keyboard Mouse Driver"
lykeys.SVCDESC = "LYDLL Keyboard Mouse Service"
